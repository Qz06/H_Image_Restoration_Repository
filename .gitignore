# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Common archives (keep local, do not upload)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Large dataset and generated image directories (ignored by default)
trainsets/**
testsets/**
results/**
superresolution/**/images/**

# Re-open folder structure so selected files can be tracked
!trainsets/**/
!testsets/**/
!results/**/
!superresolution/**/images/**/

# Representative dataset samples (first image of train/valid HR and LRx4)
!trainsets/DIV2K/DIV2K_train_HR/0001.png
!trainsets/DIV2K/DIV2K_valid_HR/0801.png
!trainsets/DIV2K/DIV2K_train_LR_bicubic/X4/0001x4.png
!trainsets/DIV2K/DIV2K_valid_LR_bicubic/X4/0801x4.png

# Keep all image files containing 808 in filename
!trainsets/**/*808*.png
!trainsets/**/*808*.jpg
!trainsets/**/*808*.jpeg
!testsets/**/*808*.png
!testsets/**/*808*.jpg
!testsets/**/*808*.jpeg
!results/**/*808*.png
!results/**/*808*.jpg
!results/**/*808*.jpeg
!superresolution/**/images/**/*808*.png
!superresolution/**/images/**/*808*.jpg
!superresolution/**/images/**/*808*.jpeg

# Representative outputs from latest BSRGAN forward inference
!results/my_bsrgan_x4_forward_3000E/0801x4.png
!results/my_bsrgan_x4_forward_3000E/0900x4.png

# Large model checkpoints (ignored by default)
model_zoo/*.pth
SR/**/models/*.pth
superresolution/**/models/*.pth
superresolution/**/models/*.pt
superresolution/**/models/*.ckpt
superresolution/**/models/*.safetensors
superresolution/**/models/*.onnx
superresolution/**/models/*.bin

# Representative pretrained/model checkpoints
!model_zoo/dncnn_25.pth
!model_zoo/my_usrnet_4.2k.pth
!SR/my-usrnet/models/4200_G.pth
!superresolution/my_bsrgan_x4_sr/models/500_G.pth
!superresolution/my_bsrgan_x4_sr/models/3000_G.pth
!superresolution/my_swinir_classical_sr/models/500_G.pth
!superresolution/my_swinir_classical_sr/models/7000_G.pth

# Keep all log files uploadable (do not ignore logs)
!*.log
!**/*.log

# Keep repository docs and markdown
!*.md
