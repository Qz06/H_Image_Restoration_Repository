{
    "task": "my_bsrgan_x4_sr", // [KEY] 任务名（与GAN阶段保持一致，便于阶段衔接）
    "model": "plain",
    "gpu_ids": [
        0
    ], // [KEY] 单卡训练
    "dist": false, // [KEY] 单卡时设为 false
    "scale": 4,
    "n_channels": 3,
    "path": {
        "root": "superresolution",
        "pretrained_netG": null,
        "pretrained_netE": null
    },
    "datasets": {
        "train": {
            "name": "train_dataset",
            "dataset_type": "blindsr",
            "dataroot_H": "trainsets/DIV2K/DIV2K_train_HR", // [KEY] 训练高质量图像目录
            "dataroot_L": null,
            "degradation_type": "bsrgan", // [KEY] bsrgan 或 bsrgan_plus
            "H_size": 320, // [KEY] 显存优化：320 -> 256
            "shuffle_prob": 0.1,
            "lq_patchsize": 72, // [KEY] 显存优化：72 -> 64
            "use_sharp": false,
            "dataloader_shuffle": true,
            "dataloader_num_workers": 8,
            "dataloader_batch_size": 24 // [KEY] 显存优化：32 -> 1
        },
        "test": {
            "name": "test_dataset",
            "dataset_type": "blindsr",
            "degradation_type": "bsrgan",
            "H_size": 320,
            "shuffle_prob": 0.1,
            "lq_patchsize": 72,
            "use_sharp": false,
            "dataroot_H": "trainsets/DIV2K/DIV2K_valid_HR", // [KEY] 验证高质量图像目录
            "dataroot_L": null
        }
    },
    "netG": {
        "net_type": "rrdbnet",
        "in_nc": 3,
        "out_nc": 3,
        "nf": 64,
        "nb": 23,
        "gc": 32,
        "ng": 2,
        "reduction": 16,
        "act_mode": "L",
        "bias": true,
        "init_type": "orthogonal",
        "init_bn_type": "uniform",
        "init_gain": 0.2
    },
    "train": {
        "G_lossfn_type": "l1",
        "G_lossfn_weight": 1.0,
        "E_decay": 0.999,
        "G_optimizer_type": "adam",
        "G_optimizer_lr": 1e-4,
        "G_optimizer_wd": 0,
        "G_optimizer_clipgrad": null,
        "G_optimizer_reuse": true,
        "G_scheduler_type": "MultiStepLR",
        "G_scheduler_milestones": [
            200000,
            400000,
            600000,
            800000,
            1000000,
            2000000
        ],
        "G_scheduler_gamma": 0.5,
        "G_regularizer_orthstep": null,
        "G_regularizer_clipstep": null,
        "G_param_strict": true,
        "E_param_strict": true,
        "val_which_model": "G", // [KEY] 周期验证用 E(EMA) 或 G
        "total_iter": 300000, // [KEY] 阶段总迭代数（建议先跑到平台期）
        "checkpoint_test": 500, // [KEY] 周期验证间隔
        "checkpoint_save": 500,
        "checkpoint_print": 100
    }
}